# ─────────────────────────────────────────────────────────────────────────────
# Job Radar — environment. Copy to `.env` and fill in. NEVER commit the real .env.
#   cp .env.example .env
# Every value below is a placeholder or a generation command — never a real secret.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (REQUIRED) ───────────────────────────────────────────────────────
# Shared Postgres. `jobradar` = owner role (created automatically by the official
# postgres image from POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB below; runs all
# migrations + is the engine's role). `jobsearch_app` = restricted role the web app
# connects as (created by docker/postgres/init-roles.sh on first boot, least-privilege
# table/column grants come from app/sql migrations).
POSTGRES_DB=jobsearch
POSTGRES_USER=jobradar
POSTGRES_PASSWORD=changeme-generate-a-strong-password

# Engine connection (as the jobradar owner role) — must match POSTGRES_* above.
PGHOST=postgres
PGPORT=5432
PGUSER=jobradar
PGPASSWORD=changeme-generate-a-strong-password
PGDATABASE=jobsearch
# JOBRADAR_DB_URL=postgres://jobradar:pass@postgres:5432/jobsearch   # optional single-URL alt to PG*

# Web app connection (as the restricted jobsearch_app role).
JOBS_DB_HOST=postgres
JOBS_DB_PORT=5432
JOBS_DB_NAME=jobsearch
JOBS_DB_USER=jobsearch_app
JOBS_DB_PASSWORD=changeme-generate-a-different-strong-password

# ── App auth (Auth.js v5) (REQUIRED) ──────────────────────────────────────────
AUTH_SECRET=# generate: openssl rand -base64 32
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
SECRETS_KEY=# 32-byte key, generate: openssl rand -base64 32 — AES-256-GCM tenant secret encryption
REGISTRATION_ENABLED=false
# Flip to true once, visit /signup to create your owner account, then set back to false
# and `docker compose restart jobs-app` (admin-only registration by design).

# ── Shared identity (REQUIRED) ────────────────────────────────────────────────
# Leave blank until AFTER the first `docker compose up`, then:
#   docker compose exec postgres psql -U jobradar -d jobsearch -c "SELECT id FROM tenants WHERE is_owner;"
# and put that value here, then `docker compose up -d engine` to restart it with the id set.
JOBRADAR_TENANT_ID=
APPLICANT_NAME=YourName
# Container path jobs-app reads tailored materials from (shared volume with the engine's
# JOBRADAR_OUTPUT_DIR) — leave as the default unless you changed the compose volume mount.
JOBS_MATERIALS_DIR=/app/job-materials

# Web port + engine container timezone (only affects when the daily digest fires, default
# 08:00 in this TZ — change to your own timezone; UTC is a safe default for a fresh install).
JOBS_APP_PORT=3000
JOBRADAR_TZ=Africa/Cairo

# ── Telegram (engine — REQUIRED for digests) ──────────────────────────────────
TELEGRAM_BOT_TOKEN=# from @BotFather
TELEGRAM_CHAT_ID=# from @userinfobot

# ── OpenAI (engine — REQUIRED for scoring + tailoring) ────────────────────────
OPENAI_API_KEY=sk-...
JOBRADAR_SCORE_MODEL=gpt-5.5
JOBRADAR_SCORE_EFFORT=high
JOBRADAR_SCORE_MAX_TOKENS=8000
JOBRADAR_SCORE_THRESHOLD=70
JOBRADAR_TAILOR_MODEL=gpt-5.5
JOBRADAR_TAILOR_EFFORT=high
JOBRADAR_TAILOR_MAX_TOKENS=8000
JOBRADAR_TAILOR_TIMEOUT_MS=360000
JOBRADAR_TAILOR_LIMIT=5

# ── Tailoring / PDF rendering (engine — first-party, no external repo needed) ─
# In-repo relative paths, resolved against engine/ at runtime. See docs/JOB-RADAR.md
# "Decoupling from career-ops" — this used to default to an external ~/career-ops checkout;
# it's now fully self-contained (engine/pdf/generate-pdf.mjs + engine/config/cv.example.md).
JOBRADAR_CV_PATH=./config/cv.md
JOBRADAR_OUTPUT_DIR=./output
JOBRADAR_PDF_SCRIPT=./pdf/generate-pdf.mjs
JOBRADAR_PDF_FORMAT=a4

# ── Digest / lifecycle tuning (engine, optional — defaults shown in code) ─────
JOBRADAR_DIGEST_HOURS=24
# JOBRADAR_FOLLOWUP_APPLIED_DAYS=
# JOBRADAR_FOLLOWUP_INTERVIEWING_DAYS=
# JOBRADAR_STALE_DISMISS_DAYS=

# ── Paid/optional sources — ALL OFF by default (engine) ───────────────────────
# The free boards (RemoteOK, Remotive, Jobicy, Arbeitnow, WeWorkRemotely, Himalayas) need
# NO keys and are always on. Everything below unlocks additional, keyed/paid sources.
# APIFY_TOKEN=apify_api_...            # unlocks MENA/Gulf/LinkedIn/Indeed/Wellfound/Mostaqll/Upwork scrapers
# JOBRADAR_ENABLE_MENA=1
# JOBRADAR_ENABLE_LINKEDIN=1
# JOBRADAR_ENABLE_INDEED=1
# JOBRADAR_ENABLE_WELLFOUND=1
# JOBRADAR_ENABLE_MOSTAQL=1
# JOBRADAR_ENABLE_UPWORK=1
# JOBRADAR_LINKEDIN_COUNT=50
# JOBRADAR_APIFY_TIMEOUT_MS=330000
# JOBRADAR_APIFY_RUN_TIMEOUT_SECS=300
# JOBRADAR_APIFY_SPEND_ALERT_PCT=
# CAREERJET_AFFID=                     # free Gulf aggregator, needs its own affiliate id
# JOBRADAR_ENABLE_CAREERJET=1
# CAREERJET_USER_IP=your.server.public.ip
# CAREERJET_REFERER=https://your-domain.example/jobs
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# JOBRADAR_REDDIT_SUBS=forhire
# JOBRADAR_HIMALAYAS_MAX=
# JOBRADAR_HN_MAX=

# ── Apply-queue tuning (engine, optional — only relevant with the job-apply skill) ─
# JOBRADAR_APPLY_LIMIT=
# JOBRADAR_APPLY_LOG_DIR=./apply-log
# JOBRADAR_APPLY_PROFILE_PATH=./config/apply-profile.json
# JOBRADAR_CREDENTIALS_PATH=./config/credentials.json

# ── Deliberately dropped — do NOT re-add these ────────────────────────────────
# ANTHROPIC_API_KEY / JOBRADAR_CLAUDE_BIN / JOBRADAR_CAREEROPS_DIR: confirmed dead code —
# the tailor runs entirely on OpenAI; these were leftovers from an earlier architecture.
# Zero references in engine/src. If you're porting more of a real .env into this file,
# leave these three out.
